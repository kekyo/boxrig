$(BUILD_DIR)/examples/wayland_transfer: examples/wayland/transfer.c $(WAYLAND_LIBRARY) $(POSIX_LIBRARY) $(SESSION_LIBRARY) $(UI_LIBRARY) $(LIBRARY) $(WAYLAND_XDG_SHELL_HEADER) $(WAYLAND_XDG_SHELL_SOURCE)
	mkdir -p $(BUILD_DIR)/examples
	$(CC) $(CPPFLAGS) $(PROJECT_CPPFLAGS) $(POSIX_CPPFLAGS) -I$(WAYLAND_PROTOCOL_DIR) $(WAYLAND_CPPFLAGS) $(PANGO_CAIRO_CPPFLAGS) $(CFLAGS) $(PROJECT_CFLAGS) $< $(WAYLAND_XDG_SHELL_SOURCE) $(WAYLAND_LIBRARY) $(POSIX_LIBRARY) $(SESSION_LIBRARY) $(UI_LIBRARY) $(LIBRARY) $(WAYLAND_LIBS) $(PANGO_CAIRO_LIBS) $(POSIX_LIBS) -o $@

$(BUILD_DIR)/examples/wayland_transfer_opengl: examples/wayland/transfer.c $(WAYLAND_OPENGL_LIBRARY) $(WAYLAND_LIBRARY) $(OPENGL_RENDERER_LIBRARY) $(POSIX_LIBRARY) $(SESSION_LIBRARY) $(UI_LIBRARY) $(LIBRARY) $(WAYLAND_XDG_SHELL_HEADER) $(WAYLAND_XDG_SHELL_SOURCE)
	mkdir -p $(BUILD_DIR)/examples
	$(CC) $(CPPFLAGS) $(PROJECT_CPPFLAGS) $(POSIX_CPPFLAGS) -I$(WAYLAND_PROTOCOL_DIR) $(WAYLAND_CPPFLAGS) $(WAYLAND_OPENGL_CPPFLAGS) $(PANGO_CAIRO_CPPFLAGS) $(CFLAGS) $(PROJECT_CFLAGS) -DBOXRIG_TRANSFER_OPENGL $< $(WAYLAND_XDG_SHELL_SOURCE) $(WAYLAND_OPENGL_LIBRARY) $(WAYLAND_LIBRARY) $(OPENGL_RENDERER_LIBRARY) $(POSIX_LIBRARY) $(SESSION_LIBRARY) $(UI_LIBRARY) $(LIBRARY) $(WAYLAND_LIBS) $(WAYLAND_OPENGL_LIBS) $(PANGO_CAIRO_LIBS) $(POSIX_LIBS) -o $@

.PHONY: test-wayland-transfer test-wayland-transfer-opengl
test: test-wayland-transfer test-wayland-transfer-opengl
test-wayland-transfer: $(BUILD_DIR)/examples/wayland_transfer
	BOXRIG_TRANSFER_VERIFY=1 tests/wayland/run_weston_test.sh $(WESTON) $<
test-wayland-transfer-opengl: $(BUILD_DIR)/examples/wayland_transfer_opengl
	BOXRIG_TRANSFER_VERIFY=1 tests/wayland/run_weston_test.sh $(WESTON) $< gl
