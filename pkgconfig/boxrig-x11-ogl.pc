prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: boxrig-x11-ogl
Description: EGL/OpenGL X11 terminal component for boxrig
Version: 0.0.0
Requires: x11, xcomposite, xrender, xfixes
Requires.private: gio-2.0, egl, gl, pango >= 1.50, pangocairo, pangoft2, cairo >= 1.18, fontconfig
Libs: -L${libdir} -lboxrig-x11-ogl -lboxrig-x11 -lboxrig-render-ogl -lboxrig-ui -lboxrig
Libs.private: -lpthread -lm
Cflags: -I${includedir}
