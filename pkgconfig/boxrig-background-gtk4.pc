prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: boxrig-background-gtk4
Description: Optional GTK 4 toplevel background effects for boxrig
Version: 0.0.0
Requires: gtk4 >= 4.18
Requires.private: boxrig-background-wayland
Libs: -L${libdir} -lboxrig-background-gtk4
Cflags: -I${includedir}
