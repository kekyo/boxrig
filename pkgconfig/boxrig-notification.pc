prefix=${pcfiledir}/../..
exec_prefix=${prefix}
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: boxrig-notification
Description: Asynchronous freedesktop notifications for boxrig
Version: 0.0.0
Requires: glib-2.0
Requires.private: gio-2.0
Libs: -L${libdir} -lboxrig-notification -lboxrig-ui -lboxrig
Cflags: -I${includedir}
