prefix={{prefix}}
libdir={{libdir}}
includedir={{includedir}}

Name: boxrig-background-gtk4
Description: Optional GTK 4 background effect adapter without native support
Version: {{version}}
Requires: gtk4 >= 4.14
Requires.private: boxrig-background-wayland
Libs: -L${libdir} -lboxrig-background-gtk4
Cflags: -I${includedir}
