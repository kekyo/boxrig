prefix={{prefix}}
libdir={{libdir}}
includedir={{includedir}}

Name: boxrig-gtk3
Description: GTK 3 retained terminal widget for boxrig
Version: {{version}}
Requires: boxrig-ui, gtk+-3.0 >= 3.24
Requires.private: wayland-client >= 1.22, ibus-1.0 >= 1.5.29, pango >= 1.50, pangocairo, pangoft2, cairo >= 1.18, fontconfig{{epoxy}}
Libs: -L${libdir} -lboxrig-gtk3
Libs.private: -lm -lpthread
Cflags: -I${includedir}
