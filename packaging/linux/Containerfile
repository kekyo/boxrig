ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Native compilation dependencies only; portable generated files arrive with
# the source snapshot, so Vite is never executed on the target architecture.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        bash binutils build-essential ca-certificates tar gzip pkg-config \
        fontconfig fonts-dejavu-core \
        libx11-dev libxcomposite-dev libxrender-dev libxfixes-dev \
        libxext-dev libxtst-dev libxdamage-dev libdbus-1-dev \
        libglib2.0-dev libpango1.0-dev libcairo2-dev libfontconfig-dev \
        libgtk-3-dev libgtk-4-dev libibus-1.0-dev \
        libwayland-dev libwayland-bin libxkbcommon-dev libdecor-0-dev \
        libepoxy-dev libgl-dev libegl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /tmp
